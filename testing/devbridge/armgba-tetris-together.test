# Tetris - armGBA Together, 2PLAYER over the link cable.
# Both consoles on both devices; each shows and plays only its own.
# Each device takes its own console to 2PLAYER; the host starts, both pick a
# height, the host starts the game. Judged by check.sh shared; the -vs
# screens must show MARIO VS. LUIGI, which Tetris shows only when linked.

all:WAIT_FOR devbridge 30000
#spruce all:TRM sh {helpers}/spruce-core.sh set GB "Tetris (World) (Rev 1).zip" armgba
#spruce all:TRM sh {helpers}/armgba-setup.sh together
# Joining agreed armGBA's link options from the files as they were then. The
# guest agrees them again with the test's, and both sessions must hold
# Together before either device opens the game: armGBA reads them only then.
#spruce guest:TRM sh {helpers}/ctl.sh sync
#spruce all:TRM sh {helpers}/check.sh armgba together
host:OPEN_GAME GB "Game Boy (GB)/Tetris (World) (Rev 1).zip"
WAIT 3000
guest:OPEN_GAME GB "Game Boy (GB)/Tetris (World) (Rev 1).zip"
all:WAIT_FOR game 30000
# The game opened in the agreed mode (and, Together, on this device's own
# console with the cores agreeing): stop here, not after the race, if not.
WAIT 4000
all:TRM sh {helpers}/check.sh armgba together Tetris
WAIT 6000

#spruce host:TRM sh {helpers}/keys.sh --bg b:0.3:2 right:0.2:0.4 right:0.2:0.4 right:0.2:0.4 right:0.2:0.4 start:0.3:0
#spruce guest:TRM sh {helpers}/keys.sh --bg b:0.3:2 right:0.2:0.4 right:0.2:0.4 right:0.2:0.4 right:0.2:0.4 sleep:0.6 start:0.3:0
WAIT 9000
all:SCREEN armgba-tetris-tog-music

host:TRM sh {helpers}/keys.sh start:0.3:3
WAIT 3000
all:SCREEN armgba-tetris-tog-vs

host:TRM sh {helpers}/keys.sh --bg right:0.2:1.2 a:0.2:0
guest:TRM sh {helpers}/keys.sh --bg right:0.2:0.4 right:0.2:0.4 a:0.2:0
WAIT 3000
host:TRM sh {helpers}/keys.sh start:0.2:3
WAIT 3000
all:SCREEN armgba-tetris-tog-play

host:TRM sh {helpers}/gameplay.sh --bg 60 left right left right a b a down
guest:TRM sh {helpers}/gameplay.sh --bg 60 left right left right a b a down
WAIT 63000
all:SCREEN armgba-tetris-tog-after

host:TRM sh {helpers}/check.sh shared Tetris 40
guest:TRM sh {helpers}/check.sh shared Tetris 40

all:TRM sh {helpers}/quit.sh minarch
#spruce all:TRM sh {helpers}/spruce-core.sh restore GB
#spruce all:TRM sh {helpers}/armgba-setup.sh restore
all:WAIT_FOR devbridge 30000
